# ================================================
# StudyMate AI — Environment Variables
# Copy this file to .env.local and fill in your values
# ================================================

# ── Supabase ──────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── AI Provider ───────────────────────────────────
# Choose one: groq | openai | openrouter | together | custom
AI_PROVIDER=groq

# Your AI API key (from your chosen provider)
# Groq (Free): https://console.groq.com
# OpenAI: https://platform.openai.com
# OpenRouter (Free models available): https://openrouter.ai
# Together AI: https://api.together.xyz
AI_API_KEY=your-ai-api-key-here

# AI Model (optional — defaults are set per provider)
# Groq default: llama-3.1-70b-versatile
# OpenAI default: gpt-4o-mini
# OpenRouter default: meta-llama/llama-3.1-70b-instruct:free
AI_MODEL=llama-3.3-70b-versatile

# For custom/local LLM (Ollama, etc.)
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Recommended Groq Models ───────────────────────
# llama-3.1-70b-versatile  (best for complex explanations)
# llama-3.1-8b-instant     (faster, good for quick Q&A)
# mixtral-8x7b-32768       (long context support)
# gemma2-9b-it             (efficient)
